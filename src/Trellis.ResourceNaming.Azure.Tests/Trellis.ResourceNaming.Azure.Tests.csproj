<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>

    <!-- xunit.v3 runs on Microsoft.Testing.Platform, which hosts tests in the test
         executable itself rather than under a VSTest adapter. Both properties are
         required: MTP needs an entry point, and the runner must be selected explicitly. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>

    <!-- Test method names are Method_Scenario_Expectation. -->
    <NoWarn>$(NoWarn),CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Core" Version="1.60.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Trellis.ResourceNaming.Azure\Trellis.ResourceNaming.Azure.csproj" />
  </ItemGroup>
</Project>
