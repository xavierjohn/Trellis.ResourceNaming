<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Trellis.ResourceNaming.Abstractions</PackageId>
    <Description>Store- and cloud-agnostic abstractions for convention-based resource naming: the IResourceNamer seam, the naming request model, and the resource-type specification.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Publishes the LLM-facing API reference for the whole ResourceNaming family (both Abstractions and
    Azure) as AgentDocs guidance. Restoring the package never installs anything: a consumer opts in with
    the Trellis.AgentDocs local tool and approves this package (see the READMEs).

    One doc covers both packages because a single expression routinely crosses the boundary - Azure's
    catalog combined with Abstractions' ResourceTypeSpec to patch a gap in it. Splitting the doc would
    force an agent to load both halves to write one line.

    Abstractions owns it because .Azure depends on it, so a project that references either package
    restores Abstractions and the guidance is available. Azure publishes no guidance of its own, so a
    consumer approves exactly one package.

    The helper is a build-only dependency (PrivateAssets="all"): it packs the document at its root
    path and generates guidance/reference-manifest.json (SHA-256, onDemand usage, description) at pack
    time, and adds nothing to the package's dependencies or build assets.
  -->
  <PropertyGroup>
    <PackageGuidanceDocument>$(MSBuildThisFileDirectory)..\..\docs\api_reference\trellis-api-resourcenaming.md</PackageGuidanceDocument>
    <PackageGuidancePath>trellis-api-resourcenaming.md</PackageGuidancePath>
    <PackageGuidanceUsage>onDemand</PackageGuidanceUsage>
    <PackageGuidanceDescription>Open when generating or changing resource names with IResourceNamer, NamingPolicy or ResourceTypeSpec, or Azure names, endpoints and URLs with AzureResourceNamer or DeployedEnvironmentOptions.</PackageGuidanceDescription>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Trellis.AgentDocs.Packaging" Version="0.1.0-preview.19" PrivateAssets="all" />
  </ItemGroup>
</Project>
