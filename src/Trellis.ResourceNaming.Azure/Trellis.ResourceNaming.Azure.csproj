<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Trellis.ResourceNaming.Azure</PackageId>
    <Description>An opinionated, CAF-aligned implementation of the Trellis Azure resource-naming convention behind IResourceNamer: workload-first names, condensed dashless types, env length-fallback, a Shared-scope uniqueness suffix, input validation, fail-don't-truncate length enforcement, and endpoint/URL resolution from a single DeployedEnvironmentOptions.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!--
      PrivateAssets="none" so Abstractions' build assets reach consumers of this
      package. Abstractions ships the API-reference copy logic in
      buildTransitive/, and the SDK's default for a ProjectReference emits
      exclude="Build,Analyzers" on the packed dependency - which suppresses
      buildTransitive and silently stops the docs from ever landing in a
      consumer that references only Trellis.ResourceNaming.Azure.
    -->
    <ProjectReference Include="..\Trellis.ResourceNaming.Abstractions\Trellis.ResourceNaming.Abstractions.csproj"
                      PrivateAssets="none" />
  </ItemGroup>
</Project>
